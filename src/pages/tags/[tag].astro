---
import MainLayout from '../../layouts/MainLayout.astro'
import PostList from '../../components/PostList.astro'
import PostCardList from '../../components/PostCardList.astro'
import ResourceList from '../../components/ResourceList.astro'
import { getCollection } from 'astro:content'

async function getAllTags() {
  const posts = await getCollection('blog')
  const tags = [...new Set(posts.flatMap(p => p.data.tags))]
  return tags
}

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  const tags = [...new Set(posts.flatMap(p => p.data.tags))]
  return tags.map(t => ({
    params: { tag: encodeURIComponent(t) },
  }))
}

const { tag: rawTag } = Astro.params
const tags = await getAllTags()
const tag = tags.find(t => encodeURIComponent(t) === rawTag)
---

<MainLayout title={`Tag: ${tag}`}>
  <article>
    <h1>Tag: <span class="smallcaps">{tag}</span></h1>
    <hr />

    <h2>Featured Posts tagged <span class="smallcaps">{tag}</span></h2>
    <PostCardList max={4} tag={tag} showTags />

    <hr>

    <h2>Posts tagged <span class="smallcaps">{tag}</span> (<a href="/blog">All Posts</a>)</h2>
    <PostList tag={tag} />

    <hr>

    <h2>Resources tagged <span class="smallcaps">{tag}</span> (<a href="/resources">All Resources</a>)</h2>
    <ResourceList tag={tag} />
  </article>
</MainLayout>
