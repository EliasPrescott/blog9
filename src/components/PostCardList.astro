---
import TagList from './TagList.astro'
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import { globPostImages, cleanAssetPath } from '../helpers'
import * as path from 'node:path'

const { tag, max, showTags } = Astro.props

let posts = await getCollection('blog')
posts = posts.filter(p => p.data.cover)

const coverImages = globPostImages()

if (tag) {
  posts = posts.filter(p => p.data.tags.includes(tag))
}

posts = posts.toSorted((a, b) => new Date(b.data.date) - new Date(a.data.date))
const totalPostCount = posts.length
const morePosts = max && max < totalPostCount

if (max) {
  posts = posts.slice(0, max)
}
---

<div class="post-card-list">
  {posts.map(p => <div class="post-card">
    <a href={`/blog/${p.id}`} class="post-card-img-link">
      <Image src={coverImages[cleanAssetPath(path.dirname(p.filePath), p.data.cover.path)]()} alt={p.data.cover.alt} />
    </a>
    <div class="post-card-details">
      <a href={`/blog/${p.id}`} class="post-link">{p.data.title} </a>
      <p>{p.data.cover.summary}</p>
      <span class="post-card-publish-date">Published {Temporal.PlainDate.from(p.data.date).toLocaleString('en-US', { dateStyle: 'long' })}</span>
      {showTags && <TagList tags={p.data.tags} max={3} />}
    </div>
  </div>)}
</div>
<br>
{morePosts && <a href="/blog/featured">☞ View all featured posts ({totalPostCount-max} more)</a>}
{posts.length === 0 && <div>No featured posts found.</div>}
